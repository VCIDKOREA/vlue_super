{
  "name": "@vlue/electron",
  "private": true,
  "version": "1.0.0",
  "description": "VLUE Electron desktop shell — KakaoTalk-style multi-window chat",
  "author": "VCID KOREA",
  "main": "main.cjs",
  "scripts": {
    "dist": "electron-builder --config electron-builder.config.cjs",
    "dist:win": "electron-builder --win --config electron-builder.config.cjs",
    "dist:mac": "electron-builder --mac --config electron-builder.config.cjs",
    "pack": "electron-builder --dir --config electron-builder.config.cjs"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "^25.1.8"
  }
}
