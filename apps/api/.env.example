# =============================================================================
# Production — apps/api/.env.production (7대 인프라 + Portone/Webhook)
# 검증: npm run production:ready  |  런타임: NODE_ENV=production
# =============================================================================
# DATABASE_URL, REDIS_URL, GEMINI_API_KEY, PORTONE_API_SECRET,
# JWT_ACCESS_SECRET (+ JWT_SECRET / SESSION_SECRET 별칭),
# FILE_STORAGE_PROVIDER (+ S3_* when s3)
# =============================================================================

PORT=8788
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# DB — Supabase 예시:
# postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# 로컬 docker-compose:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/vlue?schema=public"

# =============================================================================
# 포트원(Portone) — 코드 변경 없이 키만 넣으면 identity·본인인증 API가 사용
# (서버: imp_key / imp_secret = PORTONE_API_KEY / PORTONE_API_SECRET)
# =============================================================================
PORTONE_API_KEY=
PORTONE_API_SECRET=
# 테스트 모드 — 프론트 VITE_PORTONE_TEST_MODE=true 와 함께 사용. 실MID 승인 후 제거
# PORTONE_TEST_MODE=true
# 개발: 결제 우회 허용 (프로덕션 NODE_ENV에서도)
# VLUE_ALLOW_DEV_BILLING=1
# 구독 정기결제 배치 — POST /api/cron/subscription-billing
# SUBSCRIPTION_CRON_SECRET=
# VLUE_CRON_DEV_BYPASS_BILLING=1
# VLUE_SUBSCRIPTION_CRON_OVERDUE=1
# 상점 일반결제 개발 우회 (프론트 devShopBypass + imp_uid dev_shop_*)
# VLUE_ALLOW_DEV_SHOP=1
# 포트원 웹훅 (선택) — 설정 시 x-portone-signature 또는 imp_signature 헤더와 일치해야 함
# PORTONE_WEBHOOK_SECRET=

# JWT (프로덕션 필수) — access/refresh 토큰 서명. 비우면 개발용 기본 시크릿 사용
# JWT_ACCESS_SECRET=
# JWT_SECRET=
# SESSION_SECRET=
# REDIS_URL=redis://127.0.0.1:6379

# =============================================================================
# 카카오 OAuth (서버 리다이렉트) — REST API 키 = KAKAO_CLIENT_ID
# 카카오 개발자 > 앱 설정 > REST API 키 / Client Secret
# Redirect URI: Vite 프록시 사용 시 http://localhost:5173/api/v1/auth/kakao/callback
# =============================================================================
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/api/v1/auth/kakao/callback
# 하위 호환
KAKAO_REST_API_KEY=
# OAuth 성공·실패 후 돌아갈 프론트 (비우면 CORS_ORIGIN 첫 값)
FRONTEND_URL=http://localhost:5173

# =============================================================================
# Google OAuth (서버 리다이렉트) — Google Cloud Console > OAuth 클라이언트 ID
# Redirect URI: http://localhost:5173/api/v1/auth/google/callback
# 운영 예: https://api.vlue.kr/api/v1/auth/google/callback
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

# =============================================================================
# 네이버 OAuth (서버 리다이렉트) — 기존 검색 API NAVER_CLIENT_*와 분리 권장
# Callback URL: http://localhost:5173/api/v1/auth/naver/callback
# 운영 예: https://api.vlue.kr/api/v1/auth/naver/callback
# =============================================================================
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:5173/api/v1/auth/naver/callback

# =============================================================================
# Instagram OAuth (Instagram API with Instagram Login) — 프로 계정 연동·미디어
# Meta 개발자 > Instagram > 비즈니스 로그인 설정의 App ID / App Secret
# Redirect URI: https://api.vlue.kr/api/v1/auth/instagram/callback
# 사용자 액세스 토큰(콘솔에서 생성한 것)은 Railway에 넣지 말 것 — OAuth로 발급
# =============================================================================
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5173/api/v1/auth/instagram/callback

# =============================================================================
# FCM / Firebase Admin — 푸시 발송용 (서버). 키 발급 후 아래 중 하나로 연결
# 1) GOOGLE_APPLICATION_CREDENTIALS=/절대경로/serviceAccount.json
# 2) 또는 개별 변수(줄바꿈은 \n 이스케이프)
# =============================================================================
GOOGLE_APPLICATION_CREDENTIALS=
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# =============================================================================
# 웹 푸시(VAPID) — 선택. 프론트 public / 서버 private
# =============================================================================
# VITE_WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=

# 관리자 비밀 URL — 프론트 VITE_ADMIN_PATH 와 문자열 완전 동일해야 pending 발급 가능
# 예: /master=2026-qldlTldkdlelzhfldk?26sus4dnjf7dlf-tjfflq
ADMIN_ENTRY_PATH=

# 마스터 휴대폰(E.164, 예: +821012345678) — 본인인증 번호가 일치하고 adminDeviceKey 가 오면 is_master 등록
ADMIN_MASTER_PHONE_E164=

# 가족보호 — 오픈뱅킹 입출금 웹훅 (POST /api/family-protection/webhook/openbanking/transaction)
# 헤더 X-OpenBanking-Webhook-Secret 과 동일 값 필수
OPENBANKING_WEBHOOK_SECRET=dev-openbanking-secret
# 가족보호 elder cron — POST /api/family-protection/cron/check-elder
# FAMILY_CRON_SECRET=

# =============================================================================
# VLUE 5대 핵심 기능 백엔드
# =============================================================================
# 브이밍 (Vming) — Gemini 1.5 Flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 15초 슬라이드 MP4 합성 (서버에 ffmpeg 설치 필요)
FFMPEG_PATH=ffmpeg

# OpenAI Vision
OPENAI_API_KEY=

# 파일 스토리지 — mock(로컬) | s3(프로덕션: 오피스 스캔·자산·보안함 Evidence)
FILE_STORAGE_PROVIDER=mock

# S3-compatible storage (scan/assets) — FILE_STORAGE_PROVIDER=s3 일 때 필수
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# PG escrow / mock provider
PG_PROVIDER=mock

# SMTP / mock provider — 운영 발송: SMTP_PROVIDER=resend + RESEND_API_KEY
SMTP_PROVIDER=mock
RESEND_API_KEY=
VLUE_SIGNUP_FROM_EMAIL=noreply@vlue.kr
# cloudflare_edge (Worker forward) | smtp_relay (API가 직접 릴레이)
VLUE_EMAIL_FORWARD_MODE=cloudflare_edge
VLUE_EMAIL_DOMAIN=vlue.kr
# 기업 메일로 인정할 도메인(쉼표 구분). 기본값에 vlue.kr 포함.
# 사내 Google Workspace / Microsoft 365 도메인을 여기에 추가하세요.
# COMPANY_EMAIL_DOMAIN_ALLOWLIST=vlue.kr,yourcompany.com
VLUE_OFFICE_EMAIL_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Live bridge / embed — 외부 플랫폼 스트림 URL만 바인딩 (VLUE 서버 트래픽 0원)
LIVE_RTMP_BASE=rtmp://localhost/live
APP_BASE_URL=http://localhost:8788
# 라이브 종료 녹화 웹훅 인증 (POST /api/live/webhook/recording-complete)
# LIVE_VOD_WEBHOOK_SECRET=

# Cloudflare R2 — 상품 영상 Direct Upload (Presigned PUT, egress $0, 최대 5GB)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=vlue-product-media
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# PC agent / IoT
WS_ORIGIN=http://localhost:5173
COMPANY_LINE_WHITELIST=

# =============================================================================
# VLUE 가상 메일 · 통합 메일함 · Cloudflare 웹훅
# =============================================================================
# 인바운드 웹훅 시크릿 (Cloudflare Worker → POST /api/email-forwarding/inbound)
# VLUE_OFFICE_EMAIL_WEBHOOK_SECRET=
# cloudflare_edge: CF가 직접 포워딩, 서버는 캐시+푸시만 | smtp_relay: 서버 SMTP 릴레이
# VLUE_EMAIL_FORWARD_MODE=cloudflare_edge
# IMAP 순차 큐 (기본 50명/30초)
# VLUE_IMAP_SYNC_BATCH_SIZE=50
# VLUE_IMAP_SYNC_TICK_MS=30000
# IMAP_PROVIDER=mock
# 로컬 웹훅 테스트: ngrok http 8788 후 APP_BASE_URL=https://xxxx.ngrok-free.app

# =============================================================================
# www.vlue.kr 스테이징 잠금 (DNS 변경 없이 Coming Soon / Basic Auth)
# =============================================================================
# VLUE_WWW_STAGING_LOCK=false
# VLUE_STAGING_BASIC_USER=dev
# VLUE_STAGING_BASIC_PASS=
# VLUE_STAGING_IP_WHITELIST=1.2.3.4

# =============================================================================
# 기관 검색 크로스체크 — GET /api/v1/search/verify?keyword=
# 앱 상호 사업자 조회 — GET /api/v1/search/business?keyword=
# ⚠️ 실제 키는 Railway Variables(또는 로컬 apps/api/.env)에만 입력.
#    git 커밋·push·프론트 빌드·Dockerfile·railway.toml 등 배포 산출물에 절대 포함 금지.
# =============================================================================
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 카카오 로컬 검색 — REST API 키 (KAKAO_CLIENT_ID 와 동일 키 사용 가능)
KAKAO_REST_API_KEY=

# =============================================================================
# 카카오 알림톡 — 통화 종료 트리거 (POST /api/notifications/alimtalk/call-ended)
# KAKAO_ALIMTALK_ENABLED: mock(기본·미설정) | true(live API) | false(발송 완전 비활성)
# Live 테스트: npm run test:alimtalk-live -- 010xxxxxxxx
# =============================================================================
KAKAO_ALIMTALK_ENABLED=mock
KAKAO_ALIMTALK_PROVIDER=aligo
KAKAO_ALIMTALK_BASE_URL=https://kakaoapi.aligo.in
KAKAO_ALIMTALK_API_KEY=
KAKAO_ALIMTALK_USER_ID=
KAKAO_ALIMTALK_SENDER_KEY=
KAKAO_ALIMTALK_SENDER_PHONE=
# (선택) 알리고 토큰 — 계정에 토큰 인증이 필요한 경우
# KAKAO_ALIMTALK_TOKEN=
# (선택) Y = 알리고 testMode (과금 없이 검증)
# KAKAO_ALIMTALK_TEST_MODE=N
KAKAO_ALIMTALK_CALL_END_TEMPLATE_ID=VLUE_CALL_END_V1
# Live 일회성 테스트 수신번호 (npm run test:alimtalk-live)
# TEST_ALIMTALK_RECEIVER=01090000003
# VLUE Showcase 웹뷰 베이스 (버튼 아웃링크: /site/web/showcase/:phone)
VLUE_SHOWCASE_WEB_BASE=https://vlue.app
# 앱 다운로드 (플레이스토어/앱스토어 딥링크 또는 랜딩)
VLUE_APP_DOWNLOAD_URL=https://vlue.app/download
# 공공데이터포털 인증키 (인코딩/비인코딩 자동 재시도)
PUBLIC_DATA_SERVICE_KEY=
# 하위 호환 별칭
DATA_GO_KR_SERVICE_KEY=
NTS_BUSINESS_API_KEY=
# 선택: API별 인증키 (미설정 시 PUBLIC_DATA_SERVICE_KEY 사용)
# SMALL_BUSINESS_STORE_SERVICE_KEY=
# FSC_CORP_BASIC_SERVICE_KEY=
# 선택: API 엔드포인트 오버라이드
# SMALL_BUSINESS_STORE_API_URL=https://api.odcloud.kr/api/sbdcStoreInfoService/v1/getStoreInfo
# SBIZ_STORE_RADIUS_API_URL=http://apis.data.go.kr/B553077/api/open/sdsc2/storeListInRadius
# NTS_BUSINESS_STATUS_API_URL=https://api.odcloud.kr/api/nts-businessman/v1/status
# FSC_CORP_BASIC_API_URL=https://apis.data.go.kr/1160100/service/GetCorpBasicInfoService_V2/getCorpOutline_V2
