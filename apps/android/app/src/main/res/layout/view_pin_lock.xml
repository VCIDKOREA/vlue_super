<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pin_lock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8FAFC"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="72dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="VLUE"
            android:textColor="#2563EB"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pin_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="PIN 입력"
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pin_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/pin_future_bio_hint"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/pin_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/pin_dot_0"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/pin_dot_empty" />

            <View
                android:id="@+id/pin_dot_1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/pin_dot_empty" />

            <View
                android:id="@+id/pin_dot_2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/pin_dot_empty" />

            <View
                android:id="@+id/pin_dot_3"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/pin_dot_empty" />

            <View
                android:id="@+id/pin_dot_4"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/pin_dot_empty" />

            <View
                android:id="@+id/pin_dot_5"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/pin_dot_empty" />
        </LinearLayout>

        <TextView
            android:id="@+id/pin_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:minHeight="20dp"
            android:textColor="#DC2626"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pin_reset_cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:text="PIN을 잊으셨나요?"
            android:textColor="#2563EB"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:useDefaultMargins="true">

            <TextView
                android:id="@+id/pin_key_1"
                style="@style/PinKeyButton"
                android:text="1" />

            <TextView
                android:id="@+id/pin_key_2"
                style="@style/PinKeyButton"
                android:text="2" />

            <TextView
                android:id="@+id/pin_key_3"
                style="@style/PinKeyButton"
                android:text="3" />

            <TextView
                android:id="@+id/pin_key_4"
                style="@style/PinKeyButton"
                android:text="4" />

            <TextView
                android:id="@+id/pin_key_5"
                style="@style/PinKeyButton"
                android:text="5" />

            <TextView
                android:id="@+id/pin_key_6"
                style="@style/PinKeyButton"
                android:text="6" />

            <TextView
                android:id="@+id/pin_key_7"
                style="@style/PinKeyButton"
                android:text="7" />

            <TextView
                android:id="@+id/pin_key_8"
                style="@style/PinKeyButton"
                android:text="8" />

            <TextView
                android:id="@+id/pin_key_9"
                style="@style/PinKeyButton"
                android:text="9" />

            <TextView
                android:id="@+id/pin_key_cancel"
                style="@style/PinKeyButton"
                android:background="@android:color/transparent"
                android:text="취소"
                android:textSize="15sp"
                android:textColor="#64748B"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/pin_key_0"
                style="@style/PinKeyButton"
                android:text="0" />

            <TextView
                android:id="@+id/pin_key_del"
                style="@style/PinKeyButton"
                android:text="←"
                android:textSize="22sp" />
        </GridLayout>
    </LinearLayout>
</FrameLayout>
