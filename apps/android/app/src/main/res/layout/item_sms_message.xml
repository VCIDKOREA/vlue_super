<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/smsSender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <FrameLayout
        android:id="@+id/smsBubble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/sms_bubble_bg"
        android:padding="12dp">

        <TextView
            android:id="@+id/smsBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="36dp"
            android:textColor="#0F172A"
            android:textSize="15sp" />

        <View
            android:id="@+id/smsLinkShield"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/smsAnalyze"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/sms_analyze_btn"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="🤖 AI 분석"
            android:textColor="#1D4ED8"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/smsAnalyzing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="AI가 실제 URL 추적 및 정밀 분석 중..."
            android:textColor="#334155"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/smsBadge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:padding="10dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/smsSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#475569"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
