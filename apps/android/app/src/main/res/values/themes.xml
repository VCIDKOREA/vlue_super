<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VlueCallOverlay" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#2563EB</item>
    </style>

    <style name="PinKeyButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/pin_key_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#0F172A</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
