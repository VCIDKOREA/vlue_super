# 사무실 Windows PC — Railway가 아닌 로컬에서 agent.mjs 실행 시
# PowerShell: Get-Content .env | ForEach-Object { ... } 또는 수동 export

# 필수 — VLUE 회원 UUID (Prisma User.id)
VLUE_AGENT_USER_ID=

# 필수(프로덕션) — @vlue/api Public URL → wss
# 예: wss://xxxxx.up.railway.app/api/office/ws/agent
VLUE_AGENT_WS_URL=

# 선택
VLUE_AGENT_DEVICE_ID=Office-PC-01
VLUE_AGENT_DEVICE_LABEL=Office-PC-01
