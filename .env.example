# Vite (프론트) — 관리자 비밀 진입 전체 경로 (pathname + search, 하드코딩 금지)
# 예(스펙 §4): /master=2026-qldlTldkdlelzhfldk?26sus4dnjf7dlf-tjfflq
# apps/api 의 ADMIN_ENTRY_PATH 와 문자열이 완전히 같아야 pending 코드 발급이 됩니다.
VITE_ADMIN_PATH=

# API 베이스 — 비우면 동일 오리진 + Vite 프록시(/api → 8788). API 서버에 직접 붙일 때만:
# VITE_API_URL=http://127.0.0.1:8788
VITE_API_URL=

# Production 매니페스트: 루트 `.env.production` (npm run production:ready)
# VITE_API_URL=https://api.vlue.kr

# 디지털 인증명함 — 카카오·OG·SVG 검증용 공개 API 베이스 (실기기 카카오 공유 시 필수, 로컬만 쓰면 비워도 됨)
# VITE_CARD_PUBLIC_API_BASE=https://www.vlue.kr
# 카카오 Feed 개인화 PNG: GET /api/v1/card/kakao-feed/{cardId}.png
# 카카오 Feed 버튼 이미지 (기본 /images/btn_view_secure_card.png — CDN 미러 시 API /api/v1/card/share-button.png 동일 PNG 업로드)
# VITE_KAKAO_BIZCARD_BUTTON_IMAGE=https://www.vlue.kr/api/v1/card/share-button.png

# 디지털 인증명함 SVG — 바이럴·앱 유입 링크 (하단 배너)
# VITE_VLUE_LANDING_URL=https://www.vlue.kr
# VITE_VLUE_CREATE_CARD_URL=https://www.vlue.kr/membership
# VITE_VLUE_IOS_STORE_URL=
# VITE_VLUE_ANDROID_STORE_URL=

# =============================================================================
# 카카오 로그인 (권장: 서버 OAuth — apps/api 의 KAKAO_* 설정)
# 버튼: GET /api/v1/auth/kakao → 카카오 → /api/v1/auth/kakao/callback → 앱 JWT
# =============================================================================

# SDK 팝업 방식(선택) — JavaScript 키
# VITE_KAKAO_JAVASCRIPT_KEY=
# VITE_KAKAO_REDIRECT_URI=http://localhost:5173/

# API 서버(apps/api/.env)에 설정:
# KAKAO_CLIENT_ID=REST_API_키
# KAKAO_CLIENT_SECRET=
# KAKAO_REDIRECT_URI=http://localhost:5173/api/v1/auth/kakao/callback

# =============================================================================
# 포트원 클라이언트 — 브라우저 본인인증 팝업용 가맹점 식별자 (발급 후 여기만 수정)
# =============================================================================
# VITE_PORTONE_USER_CODE=
# 정기결제(빌링키) PG — 포트원 콘솔의 빌링 채널 (예: html5_inicis.bill)
# VITE_IAMPORT_BILLING_PG=html5_inicis.bill
# VITE_IAMPORT_BILLING_MID=
# VLUE PAGE 상점 일반결제 PG (customer_uid 없음 — 단발성)
# VITE_IAMPORT_SHOP_PG=html5_inicis
# VITE_IAMPORT_SHOP_MID=

# =============================================================================
# 웹 푸시(선택) — VAPID 공개키만 프론트에 노출
# =============================================================================
# VITE_WEB_PUSH_VAPID_PUBLIC_KEY=

# =============================================================================
# VLUE 5-core backend reference
# 실제 값은 apps/api/.env 에 설정
# =============================================================================
# DATABASE_URL=
# OPENAI_API_KEY=
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# PG_PROVIDER=mock
# SMTP_PROVIDER=mock
# WS_ORIGIN=http://localhost:5173
# APP_BASE_URL=http://localhost:8788
