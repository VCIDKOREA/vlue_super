  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([followerId, followingId])
  @@index([followingId, status])
  @@index([followerId, status])
  @@map("user_follows")
}

// -----------------------------------------------------------------------------
