// -----------------------------------------------------------------------------
// Mail Talk — 거래처 이메일별 채팅방형 메일 수발신 (Phase 1)
// -----------------------------------------------------------------------------

enum MailTalkMessageDirection {
  SENT
  RECEIVED
}

/// 유저 × 상대방 이메일 = 단일 채팅방
model MailTalkRoom {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 거래처·상대방 이메일 (소문자 정규화 저장)
  counterpartyEmail String @map("counterparty_email") @db.VarChar(254)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages MailTalkMessage[]

  @@unique([userId, counterpartyEmail])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("mail_talk_rooms")
}

/// 채팅방 말풍선 — SENT(유저 발신) / RECEIVED(상대 수신)
model MailTalkMessage {
  id String @id @default(uuid()) @db.Uuid

  roomId String       @map("room_id") @db.Uuid
  room   MailTalkRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  direction MailTalkMessageDirection @map("direction")

  /// 파싱된 최신 본문 (답장 히스토리 제거)
  bodyText String @map("body_text") @db.Text
  /// 원본 텍스트 (본문 탭용)
  rawBodyText String? @map("raw_body_text") @db.Text
  /// 원본 HTML (본문 탭용)
  bodyHtml String? @map("body_html") @db.Text
  subject  String @default("") @db.VarChar(500)

  /// 첨부파일 공개 URL 목록
  attachmentUrls String[] @default([]) @map("attachment_urls")

  /// AWS SES MessageId (발신 시)
  sesMessageId String? @map("ses_message_id") @db.VarChar(120)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([roomId, createdAt(sort: Asc)])
  @@map("mail_talk_messages")
}

/// 유저별 비즈니스 메일 템플릿 (인사말·서명·로고)
model MailTalkEmailTemplate {
  userId String @id @map("user_id") @db.Uuid
