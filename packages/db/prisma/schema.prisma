  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_business_profiles")
}

// -----------------------------------------------------------------------------
// FriendRequest — User(발신) / User(수신) M:N 을 중간 테이블로 표현
// -----------------------------------------------------------------------------

model FriendRequest {
  id String @id @default(uuid()) @db.Uuid

  fromUserId String @map("from_user_id") @db.Uuid
  fromUser   User   @relation("FriendRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)

  toUserId String @map("to_user_id") @db.Uuid
  toUser   User   @relation("FriendRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  /// 전송 시점 신청자 실명 — 수신 UI 에 표시; User.legalName 과 독립적으로 보존
  applicantLegalNameSnapshot String @map("applicant_legal_name_snapshot") @db.VarChar(120)

  isApplicantBusiness Boolean @default(false) @map("is_applicant_business")

  /// 예: ["networking","collaboration"] — 앱 코드와 맞춘 slug 배열
  purposeChecklist Json @map("purpose_checklist") @db.JsonB

  purposeText String? @map("purpose_text") @db.Text

  status FriendRequestStatus @default(pending)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([toUserId, status])
  @@index([fromUserId])
  @@index([fromUserId, toUserId])
  @@map("friend_requests")
}

// -----------------------------------------------------------------------------
// UserFollow — 비대칭 팔로우 (승인제·즉시 팔로우)
