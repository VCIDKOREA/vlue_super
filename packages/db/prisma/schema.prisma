model CampaignMatch {
  id              String      @id @default(uuid()) @db.Uuid
  campaignId      String      @map("campaign_id") @db.Uuid
  campaign        Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ownerUserId     String      @map("owner_user_id") @db.Uuid
  ownerUser       User        @relation("CampaignOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  bloggerUserId   String      @map("blogger_user_id") @db.Uuid
  bloggerUser     User        @relation("CampaignBlogger", fields: [bloggerUserId], references: [id], onDelete: Cascade)
  status          MatchStatus @default(matched)
  matchedAt       DateTime    @default(now()) @map("matched_at") @db.Timestamptz(6)
  reviewDeadlineAt DateTime?  @map("review_deadline_at") @db.Timestamptz(6)
