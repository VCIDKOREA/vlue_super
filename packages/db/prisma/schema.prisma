// VLUE — packages/db
// PostgreSQL + Prisma. User ↔ UserBusinessProfile (1:1), User ↔ FriendRequest (1:N 발신/수신).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  user
  admin
}

enum AccountStatus {
  /// 본인인증 전
  pending_identity
  /// 사업자 등 — 관리자 승인 대기 (가입 시각은 createdAt / 본인인증 후 대기 시작은 pendingApprovalAt)
  pending_approval
  active
  suspended
}

/// 실서버 매니페스트 User.status — 계정 생명주기(활성·비활성·탈퇴)
enum UserStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum FriendRequestStatus {
  pending
  accepted
  rejected
  cancelled
}

enum VouchRequestStatus {
  pending
  approved
  rejected
  cancelled
}

enum UserFollowStatus {
  pending
  active
  rejected
  cancelled
}

/// 명함 유형: 휴대폰 / 내선 / 대표번호
enum BusinessCardKind {
  mobile
  extension
  rep_number
}

enum CardVerificationStatus {
  pending
  approved
  rejected
}

enum CardMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum CampaignStatus {
  draft
  recruiting
  closed
  cancelled
}

enum CampaignTierScope {
  all
  standard_premium
  premium_only
}

enum CampaignApplicationStatus {
  applied
  accepted
  rejected
  withdrawn
}

enum MatchStatus {
  matched
  verified
  review_submitted
  settled
  overdue
  cancelled
}

enum VerificationMethod {
  gps
  receipt
  photo_meta
}

enum VerificationStatus {
  pending
  passed
  failed
}

enum ReviewStatus {
  draft
  submitted
  approved
  rejected
}

enum EscrowStatus {
  held
  released
  refunded
}

enum WalletEntryType {
  escrow_hold
  escrow_release
  withdrawal
  penalty
  credit
}

enum NotificationStatus {
  unread
  read
}

// -----------------------------------------------------------------------------
// User
// -----------------------------------------------------------------------------
// legal_name 보호 정책:
// - INSERT: 본인인증(Portone) 성공 직후 단 한 번만 비-null 로 설정 가능.
// - UPDATE: legal_name, legal_name_locked_at 은 서비스 코드에서 절대 덮어쓰지 말 것.
//           (구현 가이드: packages/db/src/guards/legal-name.immutable.ts)
// - DB 트리거(선택): production 에서 UPDATE 시 OLD.legal_name IS DISTINCT FROM NEW.legal_name 이면 RAISE.
// -----------------------------------------------------------------------------

model User {
  id     String  @id @default(uuid()) @db.Uuid
  email  String? @unique

  /// 매니페스트 phoneNumber — E.164 정규화 연락처 (예: +821012345678)
  phoneE164 String? @unique @map("phone_e164")

  /// 앱 표시용 회원 ID(슬러그). @ 없이 소문자 영숫자·밑줄 3~20자 권장 — 확정 후 변경 없음.
  publicHandle String? @unique @map("public_handle") @db.VarChar(32)

  /// V1 — #해시태그 홈 디렉토리 검색용 (유료 회원 등록)
  showcaseTags String[] @default([]) @map("showcase_tags")

  /// V1 쇼케이스 검색 상호주의 — 본인인증+활성 쇼케이스 보유 시에만 검색 권한
  hasActiveShowcase Boolean @default(false) @map("has_active_showcase")

  /// 검색 프라이버시 토글 (기본 비허용 — 옵트인)
  isPhoneSearchAllowed Boolean @default(false) @map("is_phone_search_allowed")
  isNameSearchAllowed  Boolean @default(false) @map("is_name_search_allowed")
  /// 상호(회사명) 검색 허용 — 실명(isNameSearchAllowed)과 분리
  isOrgSearchAllowed   Boolean @default(false) @map("is_org_search_allowed")
  isIdSearchAllowed    Boolean @default(false) @map("is_id_search_allowed")

  /// 팔로우 승인제 — true면 신청 pending, false면 즉시 active
  isPrivateFollow Boolean @default(false) @map("is_private_follow")

  /// 쇼케이스 비공개 — 비팔로워는 팔로워 전용 공개 범위 외 정보 마스킹
  isShowcasePrivate Boolean @default(false) @map("is_showcase_private")

  /// 기기 간 동기화 — 쇼케이스 편집 초안(사진·쇼셜링크·페이지 등)
  showcaseStyleJson Json? @map("showcase_style_json") @db.JsonB
  /// 메인 송출(라이브) 스타일 — 통화·홈 미리보기
  showcaseLiveStyleJson Json? @map("showcase_live_style_json") @db.JsonB
  /// 라이브 출처 { source: editor|mycase, at }
  showcaseLiveSourceJson Json? @map("showcase_live_source_json") @db.JsonB
  showcaseStyleUpdatedAt DateTime? @map("showcase_style_updated_at") @db.Timestamptz(6)

  /// 팔로워에게만 공개 (검색 공개와 별도 옵트인)
  isPhoneFollowersAllowed Boolean @default(true) @map("is_phone_followers_allowed")
  isNameFollowersAllowed  Boolean @default(true) @map("is_name_followers_allowed")
  isOrgFollowersAllowed   Boolean @default(true) @map("is_org_followers_allowed")
  isIdFollowersAllowed    Boolean @default(true) @map("is_id_followers_allowed")

  /// 검색 어뷰징 카운터·잠금
  searchAbuseStrikeCount Int       @default(0) @map("search_abuse_strike_count")
  searchSuspendedAt      DateTime? @map("search_suspended_at") @db.Timestamptz(6)

  securitySearchAlerts SecuritySearchAlert[]

  /// V2 쇼케이스 소셜 — 내가 누른 반응 / 내가 쓴 댓글 / 내 쇼케이스에 달린 반응·댓글
  showcaseReactionsGiven    ShowcaseReaction[] @relation("ShowcaseReactionActor")
  showcaseReactionsReceived ShowcaseReaction[] @relation("ShowcaseReactionOwner")
  showcaseCommentsAuthored  ShowcaseComment[]  @relation("ShowcaseCommentAuthor")
  showcaseCommentsReceived  ShowcaseComment[]  @relation("ShowcaseCommentOwner")

  /// V1 마이케이스(아카이브) — 쇼케이스 게시물 누적
  showcaseCases ShowcaseCase[]

  /// 쇼케이스 음원(User Original) · 퍼가기
  showcaseSoundsOwned   ShowcaseSound[]       @relation("ShowcaseSoundOwner")
  showcaseSoundBorrows  ShowcaseSoundBorrow[]
  showcaseSoundQuotas   ShowcaseSoundQuotaMonth[]

  /// 무료 회원 메인 송출 슬롯 변경 쿨다운 기준 시각
  mainBroadcastChangedAt DateTime? @map("main_broadcast_changed_at") @db.Timestamptz(6)

  /// 로그인 비밀번호(scrypt 해시). null 이면 비밀번호 로그인 불가(관리자·레거시 등).
  passwordHash String? @map("password_hash") @db.VarChar(256)

  /// 실명 — 한 번 확정되면 불변. nullable 은 "인증 전" 상태만 허용.
  legalName         String?   @map("legal_name") @db.VarChar(120)
  legalNameLockedAt DateTime? @map("legal_name_locked_at") @db.Timestamptz(6)

  identityVerified   Boolean   @default(false) @map("identity_verified")
  identityVerifiedAt DateTime? @map("identity_verified_at") @db.Timestamptz(6)

  portoneIdentityId String? @unique @map("portone_identity_id") @db.VarChar(255)

  /// 가입 경로 — 신규 회원은 vlue_native 만 허용 (소셜 신규 가입 차단)
  signupMethod String @default("vlue_native") @map("signup_method") @db.VarChar(32)

  /// @deprecated 레거시 — 신규 연동은 user_social_login_links 사용
  socialProvider String? @map("social_provider") @db.VarChar(32)
  socialId       String? @map("social_id") @db.VarChar(80)

  /// 소셜 등에서 이메일 검증 완료 여부(카카오 is_email_verified 등). 본인인증(identityVerified)과 별개.
  isVerified Boolean @default(false) @map("is_verified")

  /// 직장(회사) 도메인 메일로 가입·인증 — 디지털 명함 하이패스 연동용
  isCompanyVerified Boolean   @default(false) @map("is_company_verified")
  companyVerifiedAt DateTime? @map("company_verified_at") @db.Timestamptz(6)

  /// CI 등: 평문 저장 지양. 해시만 보관(법무·보안 정책에 따라 컬럼 제거 가능).
  ciHash Bytes? @map("ci_hash")

  /// Portone 본인인증 생년월일 YYYYMMDD
  birthDate String? @map("birth_date") @db.VarChar(8)
  /// M / F
  gender String? @map("gender") @db.VarChar(1)

  role            UserRole        @default(user)
  accountStatus   AccountStatus   @default(pending_identity) @map("account_status")

  /// 매니페스트 status — ACTIVE / INACTIVE / DELETED (탈퇴 시 DELETED + PII 파기)
  status UserStatus @default(ACTIVE) @map("user_status")

  /// 매니페스트 referrerCode — 가입 시 입력한 파트너 추천인 코드
  referrerCode String? @map("referrer_code") @db.VarChar(24)

  /// 첫해 30(월 19,800원) · 13개월차~ 15(월 24,050원). 슬라이딩·스케줄러와 동기화
  currentDiscountRate Int @default(30) @map("current_discount_rate")

  /// 사업자 회원이 pending_approval 로 들어간 시각 (관리자 큐용)
  pendingApprovalAt DateTime? @map("pending_approval_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// 1:1 — 사용자당 하나의 비즈니스 프로필 확장
  businessProfile UserBusinessProfile?

  /// 이 사용자가 보낸 친구 신청
  friendRequestsSent FriendRequest[] @relation("FriendRequestFrom")

  /// 이 사용자가 받은 친구 신청
  friendRequestsReceived FriendRequest[] @relation("FriendRequestTo")

  /// 내가 팔로우하는 사용자
  followsSent UserFollow[] @relation("UserFollowsSent")

  /// 나를 팔로우하는 사용자
  followsReceived UserFollow[] @relation("UserFollowsReceived")

  /// VLUE 디지털 명함 — 신규가입 시 신청한 경우에만 1:1 생성
  digitalCard DigitalCard?

  /// 1:1 DM — participant_low 쪽
  chatRoomsAsLow ChatRoom[] @relation("ChatRoomParticipantLow")
  /// 1:1 DM — participant_high 쪽
  chatRoomsAsHigh ChatRoom[] @relation("ChatRoomParticipantHigh")
  chatMessages    ChatMessage[]

  vouchRequestsSent     VouchRequest[] @relation("VouchFrom")
  vouchRequestsReceived VouchRequest[] @relation("VouchTo")

  adminDevices AdminDevice[]

  /// 채팅/피드에 별도 표시할 닉네임(선택)
  nickChat String? @map("nick_chat") @db.VarChar(64)
  nickFeed String? @map("nick_feed") @db.VarChar(64)

  /// 클라이언트 TERMS_VERSION 등과 일치하는 마지막 약관 동의 버전
  termsVersionAccepted String?   @map("terms_version_accepted") @db.VarChar(64)
  termsAcceptedAt      DateTime? @map("terms_accepted_at") @db.Timestamptz(6)

  /// 만 14세 미만 — 법정대리인 동의 필요 (가족보호 자녀)
  requiresParentalConsent Boolean   @default(false) @map("requires_parental_consent")
  parentalConsentAt       DateTime? @map("parental_consent_at") @db.Timestamptz(6)
  parentalGuardianUserId  String?   @map("parental_guardian_user_id") @db.Uuid
  parentalGuardianUser    User?   @relation("ParentalGuardianFor", fields: [parentalGuardianUserId], references: [id], onDelete: SetNull)
  parentalConsentWards    User[]  @relation("ParentalGuardianFor")

  businessCardsOwned BusinessCard[]      @relation("BusinessCardOwner")
  cardMemberships    CardMember[]
  authoredCardPosts  CardFeedPost[]      @relation("CardFeedPostAuthor")
  verificationLogs   VerificationLog[]

  authRefreshSessions AuthRefreshSession[]
  passwordResetTokens PasswordResetToken[]
  blocksCreated       UserBlock[]         @relation("UserBlocksCreated")
  blocksReceived      UserBlock[]         @relation("UserBlocksReceived")
  chatReadStates      ChatReadState[]
  campaignsOwned      Campaign[]
  campaignApplications CampaignApplication[]
  campaignMatches      CampaignMatch[] @relation("CampaignBlogger")
  campaignMatchOwned   CampaignMatch[] @relation("CampaignOwner")
  visitVerifications   VisitVerification[]
  reviewSubmissions    ReviewSubmission[]
  reviewDrafts         ReviewDraft[]
  walletAccount              WalletAccount?
  walletWithdrawalAccount    WalletWithdrawalAccount?
  trustScoreEvents     TrustScoreLedger[]
  penaltyEvents        PenaltyEvent[]
  notificationsOwned   OwnerNotification[] @relation("OwnerNotificationOwner")
  notificationsActor   OwnerNotification[] @relation("OwnerNotificationActor")
  boardEvents          ActiveBoardEvent[]
  letteringPhoneBlocks LetteringPhoneBlock[] @relation("LetteringBlocksOwned")
  letteringPhoneReports LetteringPhoneReport[] @relation("LetteringReportsFiled")

  vluerProfile                 UserVluerProfile?
  b2bEnterprisesAdministered   B2BEnterpriseAccount[] @relation("B2BEnterpriseAdmin")
  corporateAttributionsAsMember CorporateAttributionRequest[] @relation("AttributionMember")
  corporateMembership          UserCorporateMembership?
  subscriptions                UserSubscription[]
  subscriptionPayments         SubscriptionPayment[]
  refundQueues                 RefundQueue[]
  commissionsAsVluer           CommissionLedger[] @relation("CommissionVluer")
  commissionsAsPayer             CommissionLedger[] @relation("CommissionPayer")
  referralAttribution          ReferralAttribution?
  referralDownlines            ReferralAttribution[] @relation("ReferralSponsor")
  vluerCodeChangeRequests      VluerCodeChangeRequest[] @relation("CodeChangeMember")
  vluerReferralPenalties       VluerReferralPenalty[] @relation("PenaltyMember")
  b2bEnterprisesAcquired       B2BEnterpriseAccount[] @relation("EnterpriseAcquiredBy")

  familyProtectionAsGuardian FamilyProtectionLink[] @relation("FamilyGuardian")
  familyProtectionAsWard     FamilyProtectionLink[] @relation("FamilyWard")
  familyWardPresence         FamilyWardPresence?
  familyProtectionSettings   FamilyProtectionSettings?
  localAds                   LocalAd[]
  storeProducts              StoreProduct[] @relation("StoreProductSeller")
  shopOrdersAsBuyer          ShopOrder[]    @relation("ShopOrderBuyer")
  shopOrdersAsSeller         ShopOrder[]    @relation("ShopOrderSeller")

  memberReferralBenefitState MemberReferralBenefitState?

  /// B2B 회선·역할 — enterpriseGroupId = 대표(MASTER) user id
  lineType          LineType         @default(NONE) @map("line_type")
  enterpriseRole    EnterpriseRole   @default(NONE) @map("enterprise_role")
  enterpriseGroupId String?          @map("enterprise_group_id") @db.Uuid
  enterpriseGroupMaster User?        @relation("EnterpriseGroupMembers", fields: [enterpriseGroupId], references: [id], onDelete: SetNull)
  enterpriseGroupMembers User[]      @relation("EnterpriseGroupMembers")
  enterpriseDept    String?          @map("enterprise_dept") @db.VarChar(80)

  /// 복수계정 콤보 — 기업 회선 계정과 FK·ID 연동 없음 (사생활 격리)
  isEnterpriseVerified        Boolean   @default(false) @map("is_enterprise_verified")
  enterpriseVerifiedAt        DateTime? @map("enterprise_verified_at") @db.Timestamptz(6)
  enterpriseVerifiedEmail     String?   @map("enterprise_verified_email") @db.VarChar(254)
  enterpriseVerifyNextCheckAt DateTime? @map("enterprise_verify_next_check_at") @db.Timestamptz(6)

  personalEnterpriseMailOtps PersonalEnterpriseMailOtp[]

  userDevices              UserDevice[]
  storePurchaseRequests      StorePurchaseRequest[] @relation("StorePurchaseRequester")
  enterpriseProcurementAdds  EnterpriseProcurementCartItem[] @relation("ProcurementCartAddedBy")

  /// 사후 연동된 소셜 로그인 (카카오/네이버) — VLUE 마스터 계정 1:1 매핑
  socialLoginLinks UserSocialLoginLink[]

  /// Instagram API (Instagram Login) — 쇼케이스 게시물 선택용 연동
  instagramLink UserInstagramLink?

  userEmailMapping UserEmailMapping?
  emailForwardingNotifications EmailForwardingNotificationLog[]
  inappMailCaches InappMailCache[]
  userEmails      UserEmail[]

  mailTalkRooms         MailTalkRoom[]
  mailTalkEmailTemplate MailTalkEmailTemplate?

  auctionsSold       Auction[]              @relation("AuctionSeller")
  auctionBids        AuctionBid[]           @relation("AuctionBidder")
  auctionWins        Auction[]              @relation("AuctionWinner")
  auctionEscrowsBuy  AuctionEscrow[]        @relation("AuctionEscrowBuyer")
  auctionEscrowsSell AuctionEscrow[]        @relation("AuctionEscrowSeller")
  interestKeywords   UserInterestKeyword[]
  mediaLiveSessions  MediaLiveSession[]     @relation("MediaLiveSeller")
  sellerVodProducts  SellerVodProduct[]     @relation("SellerVodOwner")
  mediaEscrowsBuy    MediaCommerceEscrow[]  @relation("MediaEscrowBuyer")
  mediaEscrowsSell   MediaCommerceEscrow[]  @relation("MediaEscrowSeller")

  @@unique([socialProvider, socialId], map: "users_social_provider_social_id_key")
  @@index([enterpriseGroupId])
  @@index([enterpriseRole])
  @@index([ciHash])
  @@map("users")
}

// -----------------------------------------------------------------------------
// AdminDevice — 휴대폰 마스터 승인제(비밀 URL·6자리 코드·기기 단위 권한)
// -----------------------------------------------------------------------------

model AdminDevice {
  id        String @id @default(uuid()) @db.Uuid
  deviceKey String @unique @map("device_key") @db.VarChar(80)

  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// 기획자(마스터) 본인인증 완료 시 true — 한 계정·다기기 정책은 운영에서 조정
  isMaster Boolean @default(false) @map("is_master")

  /// 마스터가 6자리 코드로 승인한 기기만 true
  isAuthorized Boolean @default(false) @map("is_authorized")

  /// PC 등 비마스터 기기가 비밀 URL로 등록 시 발급되는 6자리(일회)
  authCode           String?   @map("auth_code") @db.VarChar(6)
  authCodeExpiresAt DateTime? @map("auth_code_expires_at") @db.Timestamptz(6)

  userAgent String? @map("user_agent") @db.VarChar(512)
  lastIp    String? @map("last_ip") @db.VarChar(45)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([authCode])
  @@map("admin_devices")
}

// -----------------------------------------------------------------------------
// Auth — JWT refresh rotation / logout invalidation (opaque refresh token 해시 저장)
// -----------------------------------------------------------------------------

model AuthRefreshSession {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  lastIp    String?  @map("last_ip") @db.VarChar(45)

  @@index([userId])
  @@map("auth_refresh_sessions")
}

model PasswordResetToken {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("password_reset_tokens")
}

model UserBlock {
  blockerId String @map("blocker_id") @db.Uuid
  blocker   User   @relation("UserBlocksCreated", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String @map("blocked_id") @db.Uuid
  blocked   User   @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

// -----------------------------------------------------------------------------
// Chat — 1:1 DM (두 UUID 를 정렬해 participant_low / participant_high 로 고정)
// -----------------------------------------------------------------------------

enum ChatMessageType {
  normal
  system
}

model ChatRoom {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  participantLow  String @map("participant_low") @db.Uuid
  participantHigh String @map("participant_high") @db.Uuid

  participantLowUser  User @relation("ChatRoomParticipantLow", fields: [participantLow], references: [id], onDelete: Cascade)
  participantHighUser User @relation("ChatRoomParticipantHigh", fields: [participantHigh], references: [id], onDelete: Cascade)

  messages   ChatMessage[]
  readStates ChatReadState[]

  @@unique([participantLow, participantHigh])
  @@index([participantLow])
  @@index([participantHigh])
  @@map("chat_rooms")
}

model ChatMessage {
  id          String          @id @default(uuid()) @db.Uuid
  roomId      String          @map("room_id") @db.Uuid
  room        ChatRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId    String?         @map("sender_id") @db.Uuid
  sender      User?           @relation(fields: [senderId], references: [id], onDelete: SetNull)
  /// 직장내선·위임 명함으로 송신한 경우 감사용
  senderCardId String?      @map("sender_card_id") @db.Uuid
  senderCard   BusinessCard? @relation(fields: [senderCardId], references: [id], onDelete: SetNull)
  content     String          @db.Text
  messageType ChatMessageType @default(normal) @map("message_type")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

/// 방별 사용자 읽음 커서(상대방 읽음 확인·동기화용)
model ChatReadState {
  roomId String @map("room_id") @db.Uuid
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadMessageId String?   @map("last_read_message_id") @db.Uuid
  lastReadAt        DateTime? @map("last_read_at") @db.Timestamptz(6)

  @@id([roomId, userId])
  @@index([userId])
  @@map("chat_read_states")
}

// -----------------------------------------------------------------------------
// DigitalCard — 온보딩에서 「디지털 명함 발급 신청」 시에만 발급(행 생성)
// -----------------------------------------------------------------------------

model DigitalCard {
