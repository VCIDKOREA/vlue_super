  user   User   @relation("BusinessCardOwner", fields: [userId], references: [id], onDelete: Cascade)

  kind      BusinessCardKind @map("kind")
  phoneE164 String           @unique @map("phone_e164") @db.VarChar(24)

  displayName String? @map("display_name") @db.VarChar(120)
  jobTitle    String? @map("job_title") @db.VarChar(120)
  companyName String? @map("company_name") @db.VarChar(200)
  profileJson Json?   @map("profile_json") @db.JsonB

  verificationStatus CardVerificationStatus @default(approved) @map("verification_status")
  /// 내선/대표 등 유료 라인 — 승인된 경우에만 사업 피드 생성 허용
