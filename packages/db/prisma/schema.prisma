model OfficeExcelWorkbook {
  id                  String              @id @default(uuid()) @db.Uuid
  ownerUserId         String              @map("owner_user_id") @db.Uuid
  title               String              @db.VarChar(300)
  templateId          String?             @map("template_id") @db.VarChar(80)
  status              ExcelWorkbookStatus @default(draft)
  headRevisionId      String?             @unique @map("head_revision_id") @db.Uuid
  headRevisionNum     Int                 @default(0) @map("head_revision_num")
  lastExportedAssetId String?             @map("last_exported_asset_id") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  headRevision OfficeExcelRevision?  @relation("WorkbookHead", fields: [headRevisionId], references: [id], onDelete: SetNull)
  revisions    OfficeExcelRevision[] @relation("WorkbookRevisions")
  jobs         OfficeExcelGenerationJob[]

  @@index([ownerUserId, updatedAt(sort: Desc)])
  @@map("office_excel_workbooks")
}

model OfficeExcelRevision {
  id               String   @id @default(uuid()) @db.Uuid
  workbookId       String   @map("workbook_id") @db.Uuid
  revisionNum      Int      @map("revision_num")
  parentRevisionId String?  @map("parent_revision_id") @db.Uuid
  modelJson        Json     @map("model_json") @db.JsonB
  patchJson        Json?    @map("patch_json") @db.JsonB
  changeSummary    String?  @map("change_summary") @db.VarChar(500)
  authorUserId     String   @map("author_user_id") @db.Uuid
  authorClient     String   @default("web") @map("author_client") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workbook     OfficeExcelWorkbook  @relation("WorkbookRevisions", fields: [workbookId], references: [id], onDelete: Cascade)
  headOf       OfficeExcelWorkbook? @relation("WorkbookHead")
  resultOfJobs OfficeExcelGenerationJob[] @relation("JobResultRevision")

  @@unique([workbookId, revisionNum])
  @@index([workbookId, revisionNum(sort: Desc)])
  @@map("office_excel_revisions")
}

model OfficeExcelGenerationJob {
  id                 String                @id @default(uuid()) @db.Uuid
  workbookId         String?               @map("workbook_id") @db.Uuid
  ownerUserId        String                @map("owner_user_id") @db.Uuid
  promptText         String                @map("prompt_text") @db.Text
  templateId         String?               @map("template_id") @db.VarChar(80)
  status             ExcelGenerationStatus @default(PENDING)
  progress           Int                   @default(0)
  resultRevisionId   String?               @map("result_revision_id") @db.Uuid
  errorMessage       String?               @map("error_message") @db.VarChar(500)
  agentTraceJson     Json?                 @map("agent_trace_json") @db.JsonB
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  workbook       OfficeExcelWorkbook?  @relation(fields: [workbookId], references: [id], onDelete: SetNull)
  resultRevision OfficeExcelRevision?  @relation("JobResultRevision", fields: [resultRevisionId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, createdAt(sort: Desc)])
  @@map("office_excel_generation_jobs")
}

model OfficeExcelTemplate {
  id          String  @id @db.VarChar(80)
  category    String  @db.VarChar(40)
  title       String  @db.VarChar(200)
  description String? @db.Text
  modelJson   Json    @map("model_json") @db.JsonB
  promptHints Json?   @map("prompt_hints") @db.JsonB
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")

  @@map("office_excel_templates")
}

// -----------------------------------------------------------------------------
// VLUE 경매 — 입찰 · 에스크로 · 키워드 알림
// -----------------------------------------------------------------------------

enum AuctionCondition {
  new_item
  used_item
}

enum AuctionStatus {
  scheduled
  live
  ended
  settled
  cancelled
}

enum AuctionEscrowStatus {
  pending
  held
  released
  refunded
}

enum InterestKeywordSource {
  watchlist
  search
}

model Auction {
  id String @id @default(uuid()) @db.Uuid

  sellerUserId String @map("seller_user_id") @db.Uuid
  seller       User   @relation("AuctionSeller", fields: [sellerUserId], references: [id], onDelete: Cascade)

  title       String @db.VarChar(200)
  description String @default("") @db.Text
  category    String @default("전체") @db.VarChar(40)
  keywords    String @default("") @db.VarChar(300)

  condition      AuctionCondition @default(used_item)
  shippingFeeKrw Int              @default(0) @map("shipping_fee_krw")
  imageUrls      Json             @default("[]") @map("image_urls") @db.JsonB
  /// YouTube/Vimeo 등 외부 임베드 URL (서버 스토리지 미사용)
  videoUrl       String?          @map("video_url") @db.VarChar(1000)

  startPriceKrw  Int  @map("start_price_krw")
  currentPriceKrw Int @map("current_price_krw")
  buyNowPriceKrw Int? @map("buy_now_price_krw")
  bidCount       Int  @default(0) @map("bid_count")

  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)
  status   AuctionStatus @default(scheduled)

  winnerUserId String? @map("winner_user_id") @db.Uuid
  winner       User?   @relation("AuctionWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)

  marketPriceJson Json? @map("market_price_json") @db.JsonB

  bids   AuctionBid[]
  escrow AuctionEscrow?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, endsAt])
  @@index([sellerUserId, createdAt(sort: Desc)])
  @@index([category, status])
  @@map("auctions")
}

model AuctionBid {
  id String @id @default(uuid()) @db.Uuid

  auctionId String  @map("auction_id") @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  bidderUserId String @map("bidder_user_id") @db.Uuid
  bidder       User   @relation("AuctionBidder", fields: [bidderUserId], references: [id], onDelete: Cascade)

  amountKrw Int @map("amount_krw")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([auctionId, amountKrw(sort: Desc)])
  @@index([bidderUserId, createdAt(sort: Desc)])
  @@map("auction_bids")
}

model AuctionEscrow {
  id String @id @default(uuid()) @db.Uuid

  auctionId String  @unique @map("auction_id") @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  buyerUserId String @map("buyer_user_id") @db.Uuid
  buyer       User   @relation("AuctionEscrowBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)

  sellerUserId String @map("seller_user_id") @db.Uuid
  seller       User   @relation("AuctionEscrowSeller", fields: [sellerUserId], references: [id], onDelete: Cascade)

  amountKrw      Int @map("amount_krw")
  shippingFeeKrw Int @default(0) @map("shipping_fee_krw")
  status         AuctionEscrowStatus @default(pending)

  merchantUid String? @map("merchant_uid") @db.VarChar(80)
  escrowRef   String? @map("escrow_ref") @db.VarChar(120)

  heldAt     DateTime? @map("held_at") @db.Timestamptz(6)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([buyerUserId, status])
  @@index([sellerUserId, status])
  @@map("auction_escrows")
}

model UserInterestKeyword {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  keyword String @db.VarChar(80)
  source  InterestKeywordSource @default(watchlist)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, keyword])
  @@index([keyword])
  @@map("user_interest_keywords")
}

// -----------------------------------------------------------------------------
// 실시간 라이브 · VOD 커머스 — 미디어 바이트는 외부 CDN/플랫폼만 사용 (API 비용 0원)
// -----------------------------------------------------------------------------

enum SellerVodSource {
  live_recording
  direct_upload
  external_link
}

enum SellerVodStatus {
  processing
  ready
  archived
}

enum MediaLiveStatus {
  scheduled
  live
  ended
}

enum MediaEscrowPaymentStatus {
  pending_payment
  ESCROW_HOLD
  released
  refunded
  failed
}

/// 판매자 외부 라이브 스트림 세션 — streamUrl 메타데이터만 보관
model MediaLiveSession {
  id String @id @default(uuid()) @db.Uuid

  sellerUserId String @map("seller_user_id") @db.Uuid
  seller       User   @relation("MediaLiveSeller", fields: [sellerUserId], references: [id], onDelete: Cascade)

  title       String @default("") @db.VarChar(200)
  /// Instagram/TikTok/YouTube Live HLS·m3u8·임베드 URL — 서버 스트리밍 없음
  streamUrl   String @map("stream_url") @db.VarChar(1000)
  platform    String @default("youtube") @db.VarChar(32)
  aspectRatio String @default("16:9") @map("aspect_ratio") @db.VarChar(8)
  status      MediaLiveStatus @default(live)

  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  vodProducts SellerVodProduct[]

  @@index([sellerUserId, status])
  @@map("media_live_sessions")
}

/// 라이브 종료 후 VOD · 직접 업로드 영상 — 개인 상점 [지난 라이브 특가] 리스팅
model SellerVodProduct {
  id String @id @default(uuid()) @db.Uuid

  sellerUserId String @map("seller_user_id") @db.Uuid
  seller       User   @relation("SellerVodOwner", fields: [sellerUserId], references: [id], onDelete: Cascade)

  liveSessionId String?           @map("live_session_id") @db.Uuid
  liveSession   MediaLiveSession?   @relation(fields: [liveSessionId], references: [id], onDelete: SetNull)

  title        String @db.VarChar(200)
  productTitle String? @map("product_title") @db.VarChar(200)
  /// CDN public URL 또는 외부 스트리밍 주소 (텍스트만 저장)
  videoUrl     String @map("video_url") @db.VarChar(1000)
  thumbUrl     String? @map("thumb_url") @db.VarChar(1000)
  aspectRatio  String @default("16:9") @map("aspect_ratio") @db.VarChar(8)
  platform     String? @db.VarChar(32)
  source       SellerVodSource @default(external_link)
  status       SellerVodStatus @default(ready)
  category     String @default("past_live_deals") @db.VarChar(40)
  priceKrw     Int?    @map("price_krw")
  durationSec  Int?    @map("duration_sec")
  viewCount    Int     @default(0) @map("view_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([sellerUserId, category, status])
  @@map("seller_vod_products")
}

/// 라이브/VOD 인앱 결제 — 에스크로 예치 (payment_status: ESCROW_HOLD)
model MediaCommerceEscrow {
  id String @id @default(uuid()) @db.Uuid

  buyerUserId String @map("buyer_user_id") @db.Uuid
  buyer       User   @relation("MediaEscrowBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)

  sellerUserId String @map("seller_user_id") @db.Uuid
  seller       User   @relation("MediaEscrowSeller", fields: [sellerUserId], references: [id], onDelete: Cascade)

  feedId     String  @map("feed_id") @db.VarChar(120)
  campaignId String? @map("campaign_id") @db.VarChar(120)
  productTitle String @map("product_title") @db.VarChar(200)
  amountKrw    Int    @map("amount_krw")

  merchantUid String @unique @map("merchant_uid") @db.VarChar(80)
  impUid      String? @map("imp_uid") @db.VarChar(80)
  paymentStatus MediaEscrowPaymentStatus @default(pending_payment) @map("payment_status")
  receiptUrl    String? @map("receipt_url") @db.VarChar(512)
  paidAt        DateTime? @map("paid_at") @db.Timestamptz(6)
  rawResponse   Json? @map("raw_response") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([buyerUserId, paymentStatus])
  @@index([sellerUserId, paymentStatus])
  @@map("media_commerce_escrows")
}

// -----------------------------------------------------------------------------
// 카카오 알림톡 — 통화 종료 발송 로그 · 수신거부
// -----------------------------------------------------------------------------

/// 통화 종료 알림톡 발송 이력 (1일 1회 제한 · peerPhone 기준)
model AlimtalkSendLog {
  id        String   @id @default(uuid()) @db.Uuid
  peerPhone String   @map("peer_phone") @db.VarChar(24)
  sentAt    DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)
  direction String   @default("outbound") @db.VarChar(16)

  @@index([peerPhone, sentAt(sort: Desc)])
  @@map("alimtalk_send_logs")
}

/// 알림톡 수신거부(블랙리스트) — 번호 단위 원천 차단
model AlimtalkOptOut {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String   @unique @db.VarChar(24)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("alimtalk_opt_outs")
}
