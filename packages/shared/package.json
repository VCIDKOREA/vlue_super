{
  "name": "@vlue/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./money": {
      "import": "./dist/money/moneyKrw.js",
      "default": "./dist/money/moneyKrw.js"
    },
    "./membership": {
      "import": "./dist/membership/membershipBmConstants.js",
      "default": "./dist/membership/membershipBmConstants.js"
    },
    "./settlement": {
      "import": "./dist/settlement/referralSettlementPolicy.js",
      "default": "./dist/settlement/referralSettlementPolicy.js"
    },
    "./settlement/constants": {
      "import": "./dist/settlement/settlementConstants.js",
      "default": "./dist/settlement/settlementConstants.js"
    },
    "./signup": {
      "import": "./dist/signup/signupGateCore.js",
      "default": "./dist/signup/signupGateCore.js"
    },
    "./signup/reservedIds": {
      "types": "./dist/signup/reservedIds.d.ts",
      "import": "./dist/signup/reservedIds.js",
      "default": "./dist/signup/reservedIds.js"
    },
    "./phone": {
      "import": "./dist/phone/krPhone.js",
      "default": "./dist/phone/krPhone.js"
    },
    "./referral": {
      "import": "./dist/referral/referralChannelPolicy.js",
      "default": "./dist/referral/referralChannelPolicy.js"
    },
    "./pricing/pricingConfigTypes": {
      "import": "./dist/pricing/pricingConfigTypes.js",
      "default": "./dist/pricing/pricingConfigTypes.js"
    },
    "./excel": {
      "types": "./dist/excel/workbookSchema.d.ts",
      "import": "./dist/excel/workbookSchema.js",
      "default": "./dist/excel/workbookSchema.js"
    },
    "./policy/minor-signup": {
      "import": "./dist/policy/minorSignupPolicy.js",
      "default": "./dist/policy/minorSignupPolicy.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
