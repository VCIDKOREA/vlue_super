# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Stage 1: Build shared and web
FROM base AS builder

WORKDIR /app

# Copy root and workspace package files
COPY package.json package-lock.json ./
COPY packages/db/package.json ./packages/db/
COPY packages/db/prisma ./packages/db/prisma/
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json ./apps/api/
COPY web/package.json ./web/

# Install dependencies
RUN npm ci

# Copy source trees
COPY packages/shared ./packages/shared
COPY web ./web
COPY scripts ./scripts
COPY src ./src

# Environment variables for Vite production build
ENV NODE_ENV=production
ENV REQUIRE_PC_INSTALLER=0
ENV VLUE_PC_INSTALLER_URL="https://github.com/VCIDKOREA/vlue_super/releases/download/pc-v1.0.0/VLUE-Setup-1.0.0.exe"

# Copy production env file for Vite bundle baking (if present)
COPY web/.env.production* ./web/

# Build shared library then web application
RUN npm run build -w @vlue/shared && \
    npm run build -w @vlue/web

# Stage 2: Runtime image for serving web
FROM base AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8080

COPY package.json package-lock.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder /app/web ./web

EXPOSE 8080

CMD ["npm", "run", "start", "-w", "@vlue/web"]
