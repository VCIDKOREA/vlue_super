# @vlue/web — Vite 환경 변수 (복사: .env 또는 .env.local)
# 프로덕션 빌드: .env.production (gitignore, 로컬에 유지)

# === 사이트 셸 (www vs 앱) ===
# www | app — 비우면 호스트·경로로 자동 (/app = 앱, www.vlue.kr = 웹)
# VITE_SITE_SHELL=www

# === www.vlue.kr 스테이징 잠금 (기본 해제 — 필요 시 true) ===
# VITE_WWW_STAGING_LOCK=true

# === /app 브라우저 접근 (Electron·네이티브 전용 정책) ===
# 로컬에서 크롬으로 /app 테스트 시에만 true
# VITE_ALLOW_BROWSER_APP=true
# VITE_VLUE_PLAY_STORE_URL=
# VITE_VLUE_APP_STORE_URL=
# Windows PC 설치 파일 — GitHub Release 권장 (www.vlue.kr/downloads 는 Cloudflare SPA 캐시 이슈)
# VITE_VLUE_PC_WINDOWS_URL=https://github.com/VCIDKOREA/vlue_super/releases/download/pc-v1.0.0/VLUE-Setup-1.0.0.exe
# VITE_VLUE_PC_MAC_URL=

# === API (필수 — api·web 호스트 분리 시) ===
VITE_API_URL=https://api.vlue.kr

# 로컬 API만 쓸 때: 비우고 vite proxy /api → 127.0.0.1:8788
# VITE_API_URL=

# === Supabase (DM Realtime) ===
VITE_SUPABASE_URL=https://ywhjhdpecwvaujiagaln.supabase.co
VITE_SUPABASE_ANON_KEY=

# === 공개 URL (카카오 명함·OG) ===
VITE_CARD_PUBLIC_API_BASE=https://www.vlue.kr
VITE_VLUE_LANDING_URL=https://www.vlue.kr
VITE_VLUE_CREATE_CARD_URL=https://www.vlue.kr/membership

# === 포트원·카카오 (루트 .env 와 동일 값) ===
# VITE_PORTONE_USER_CODE=
# 네이버페이/실MID 승인 전 true — 결제 버튼이 Premium 부여. 승인 후 false
# VITE_PORTONE_TEST_MODE=true
# VITE_KAKAO_JAVASCRIPT_KEY=

# FCM 웹 푸시(부모 승인·가족보호) — Firebase Console Web 앱 + VAPID 키
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=vlue-c6c0b.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=vlue-c6c0b
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_WEB_PUSH_VAPID_PUBLIC_KEY=
# VITE_ADMIN_PATH=
# 관리자 JWT 콘솔(AdminConsoleApp) — vlue.kr 에서 /admin 금지, 비밀 전체 경로만
# 예: /ops-console=2026-vlue-k7m9p2q4?gate=a8f3e2b1c0d9
# 로컬: 비워두면 http://localhost:5173/admin 자동 허용
# VITE_ADMIN_CONSOLE_PATH=
