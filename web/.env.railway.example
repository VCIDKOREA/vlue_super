# Railway Variables — @vlue/web 서비스 (빌드 시 VITE_* 가 번들에 박힘 → 변경 후 Redeploy 필수)
#
# 빌드 실패(vite/tsc not found) 시 서비스 Variables에 추가:
# NIXPACKS_NODE_INSTALL_DEV_DEPS=true

# Railway @vlue/web — 프로덕션 API (DNS 연결 후)
VITE_API_URL=https://api.vlue.kr

VITE_SUPABASE_URL=https://ywhjhdpecwvaujiagaln.supabase.co
VITE_SUPABASE_ANON_KEY=

VITE_CARD_PUBLIC_API_BASE=https://api.vlue.kr
VITE_VLUE_LANDING_URL=https://www.vlue.kr
VITE_VLUE_CREATE_CARD_URL=https://www.vlue.kr/membership

VITE_PORTONE_USER_CODE=
# PASS(IMP.certification) — 결제 PG와 분리. Railway에 넣고 재배포해야 번들에 반영
VITE_IAMPORT_CERT_PG=inicis_unified
VITE_IAMPORT_CERT_MID=
# MID가 채널과 안 맞으면 true (pg=inicis_unified 만 전송)
# VITE_IAMPORT_CERT_OMIT_MID=true
VITE_KAKAO_JAVASCRIPT_KEY=

# FCM 웹 푸시 — Firebase Console > 프로젝트 설정 > 일반 > 내 앱(Web) + Cloud Messaging VAPID
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=vlue-c6c0b.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=vlue-c6c0b
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_WEB_PUSH_VAPID_PUBLIC_KEY=

# Windows PC — 비우면 현재 도메인 /downloads/VLUE-Setup-1.0.0.exe?v=1.0.0 사용
# VITE_VLUE_PC_WINDOWS_URL=
