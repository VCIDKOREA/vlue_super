{
  "name": "vlue-superapp",
  "private": true,
  "version": "1.0.0",
  "description": "VLUE 슈퍼앱 모노레포 — web(웹) + apps(모바일·API) + packages(공통)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w @vlue/web",
    "build": "npm run build -w @vlue/web",
    "build:all": "npm run api:build && npm run web:build",
    "preview": "npm run preview -w @vlue/web",
    "web:dev": "npm run dev -w @vlue/web",
    "web:build": "npm run build -w @vlue/web",
    "api:dev": "npm run dev -w @vlue/api",
    "api:build": "npm run build -w @vlue/db && npm run build -w @vlue/shared && npm run build -w @vlue/api",
    "api:test:core": "npm run test:core-smoke -w @vlue/api",
    "api:test:policy": "npm run test:referral-policy -w @vlue/api",
    "api:test:signup": "npm run test:signup-gate -w @vlue/api",
    "shared:typecheck": "npm run typecheck -w @vlue/shared",
    "db:migrate": "npm run migrate -w @vlue/db",
    "db:deploy": "npm run deploy -w @vlue/db",
    "db:seed": "npm run seed -w @vlue/db",
    "db:deploy:safe": "node scripts/migrate-deploy-safe.mjs",
    "db:supabase-rls-lockdown": "node scripts/apply-supabase-rls-lockdown.mjs",
    "db:supabase-product-media": "node scripts/apply-supabase-product-media.mjs",
    "db:generate": "npm run generate -w @vlue/db",
    "db:generate:safe": "node scripts/prisma-generate-safe.mjs",
    "seed:test-accounts": "node scripts/seed-test-accounts.mjs",
    "seed:admin-account": "node scripts/seed-admin-account.mjs",
    "openbanking:webhook-mock": "node scripts/openbanking-webhook-mock.mjs",
    "android:sync": "node scripts/sync-android-lettering.mjs",
    "android:setup": "node scripts/sync-android-lettering.mjs && node scripts/setup-android-local.mjs && node scripts/install-gradle-wrapper.mjs",
    "android:setup:device": "node scripts/sync-android-lettering.mjs && node scripts/setup-android-local.mjs --device physical && node scripts/install-gradle-wrapper.mjs",
    "android:assemble": "node scripts/android-assemble.mjs assembleDebug",
    "android:install": "node scripts/android-assemble.mjs installDebug",
    "android:launch": "adb shell am start -n kr.vlue.app/kr.vlue.calloverlay.MainActivity",
    "pc-agent:start": "npm run start -w @vlue/pc-agent",
    "office:email-sim": "node scripts/simulate-office-email-webhook.mjs",
    "production:ready": "node scripts/production-ready.mjs",
    "deploy:lock": "node scripts/production-ready.mjs --lock",
    "verify:api-domain": "node scripts/verify-api-domain.mjs",
    "verify:www-domain": "node scripts/verify-www-domain.mjs",
    "pages:sync": "node scripts/sync-coming-soon-docs.mjs",
    "pages:dev": "npx serve . -l 4173",
    "electron:dev": "concurrently -k \"npm run dev -w @vlue/web\" \"wait-on http://127.0.0.1:5173 && cross-env VLUE_ELECTRON_DEV=1 electron apps/electron/main.cjs\""
  },
  "devDependencies": {
    "concurrently": "^9.2.3",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "typescript": "^5.7.0",
    "wait-on": "^8.0.5"
  }
}
